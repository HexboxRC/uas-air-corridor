<?xml version="1.0"?>
<sdf version="1.9">
  <!-- Air cell: a single 200 x 50 x 50 m structured-airspace volume.
       Visual-only (no collision) so a UAV flies THROUGH it, not into it.
       Long axis is X, so a yaw in the world <pose> points it down the lane bearing.
       Origin is the cell center (matches the paper's center-point reference). -->
  <model name="air_cell">
    <static>true</static>
    <link name="cell">
      <visual name="vol">
        <geometry>
          <box>
            <size>200 50 50</size>
          </box>
        </geometry>
        <!-- 0 = opaque, 1 = fully transparent -->
        <transparency>0.7</transparency>
        <material>
          <ambient>0.1 0.45 0.9 0.3</ambient>
          <diffuse>0.1 0.45 0.9 0.3</diffuse>
          <specular>0.1 0.1 0.1 1.0</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
