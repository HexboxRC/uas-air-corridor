<?xml version="1.0" ?>
<!-- Two air corridors, side by side, each 16 flush 5 x 5 x 5 m cubes along +X.
     Each corridor: 5 m wide x 5 m tall x 80 m long.
     Blue corridor is centered at y = 0; red corridor is beside it at y = 10
     (a 5 m gap between them).
     Blue: alternating sky-blue / ocean-blue.
     Red:  alternating light-red / dark-red.
     Target: Gazebo Sim (gz-sim / Ignition). Each visual carries its own
     ambient + diffuse + specular so the colors persist (no gray fallback). -->
<sdf version="1.9">

  <!-- Single root model containing both corridors (blue links + red links).
       Kept as one <model> because the file is loaded as a model, and an SDF
       model file may only have one top-level model. -->
  <model name="air_corridors">
    <static>true</static>

    <!-- ============================ BLUE CORRIDOR (y = 0) ============================ -->
    <link name="blue_cube_00">
      <pose>2.5 0 2.5 0 0 0</pose>
      <visual name="blue_cube_00_visual">
        <geometry><box><size>5 5 5</size></box></geometry>
        <material>
          <ambient>0.30 0.48 0.58 1</ambient>
          <diffuse>0.53 0.81 0.98 1</diffuse>
          <specular>0.20 0.20 0.20 1</specular>
        </material>
      </visual>
      <collision name="blue_cube_00_collision">
        <geometry><box><size>5 5 5</size></box></geometry>
      </collision>
    </link>

